{
  "name": "minecraft-server-manager",
  "version": "1.0.1",
  "description": "Gestor local de servidores de Minecraft (Vanilla / Forge / NeoForge) con detección automática de mods de servidor",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fjalc99/Aplicacion-Servers-Minecraft.git"
  },
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "test": "node --test"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "pidusage": "^3.0.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.minecraftservermanager.app",
    "productName": "Minecraft Server Manager",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-512.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Fjalc99",
        "repo": "Aplicacion-Servers-Minecraft",
        "releaseType": "release"
      }
    ]
  }
}
